# --- Segreti / config locale (mai committare) ---
.env
.env.local
*.local

# --- Corpus reale del cliente (dati sensibili, mai committare) ---
corpus/*
!corpus/.gitkeep

# --- Output locali generati (catalogo, indici, cache) ---
data/*
!data/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.uv/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Claude Code (impostazioni locali/personali) ---
.claude/settings.local.json

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Docker volumes locali ---
qdrant_storage/
