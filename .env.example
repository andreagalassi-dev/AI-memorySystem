# === Template configurazione — copiare in .env (NON committare .env) ===
# cp .env.example .env

# --- Provider LLM (auto / ollama / openai / gemini / anthropic / mock) ---
# Di default 'auto' usa le chiavi API se presenti, altrimenti prova Ollama locale,
# con fallback automatico su Mock in caso di modelli assenti.
AIKE_LLM_PROVIDER=auto

# Opzione Cloud API (se non vuoi usare modelli locali pesanti):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- LLM locale (Ollama / MLX) ---
OLLAMA_BASE_URL=http://localhost:11434
# Modello principale in produzione (think off per evitare erosione contesto)
BRAIN_MODEL=gemma4:26b-mlx
BRAIN_THINK=False
# Modello di fallback su errore
OLLAMA_MODEL=qwen2.5:14b

# --- Qdrant (vector DB) ---
# In locale: QDRANT_HOST=localhost. Dentro Docker (rete aike_net): QDRANT_HOST=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- PostgreSQL (registro versioni, P4) ---
# In locale: POSTGRES_HOST=localhost. Dentro Docker (rete aike_net): POSTGRES_HOST=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aike
POSTGRES_PASSWORD=aike_dev
POSTGRES_DB=aike_registry

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Percorsi dati (Fase 0 locale) ---
CORPUS_DIR=./corpus
DATA_DIR=./data

# --- UI (Chainlit) ---
CHAINLIT_AUTH_SECRET= # Generare con: chainlit create-secret
AIKE_UI_USERS=tecnico:password:tecnico,commerciale:password:commerciale,amministrazione:password:amministrazione
DATABASE_URL=postgresql+psycopg_async://aike:aike_dev@localhost:5432/aike_registry?options=-c%20search_path=chainlit

# Nota: per avviare la demo Streamlit permanente, l'extra "demo" e' richiesto finche' la demo vive (es. uv sync --extra demo)

# Riservatezza dati: tutto il flusso è locale; flag offline per installazioni air-gapped
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
CHAINLIT_NO_TELEMETRY=true

# --- Ricerca online (epica H) — OPZIONALE, spenta di default ---------------
# Il ramo web esiste solo se AIKE_WEB_SEARCH e' diverso da "off": senza questa
# variabile il sistema si comporta ESATTAMENTE come prima (installazione
# air-gapped). Il servizio `searxng` del compose sta dietro il profilo "web" e
# NON parte con un normale `docker compose up`.
#   off      = nessun ramo web (default)
#   searxng  = SearXNG auto-ospitato su $SEARXNG_URL
#   frozen   = cassetta registrata, riproducibile senza rete (demo)
AIKE_WEB_SEARCH=off
# In locale: http://localhost:8888. Dentro Docker (rete aike_net): http://searxng:8080
SEARXNG_URL=http://localhost:8888
# Cassetta per AIKE_WEB_SEARCH=frozen (registrata con websearch.record_cassette)
AIKE_WEB_CASSETTE=./tests/fixtures/web_cassette_demo.json
# Cascata web NEL GRAFO: il motore qui sopra dice "esiste una ricerca online",
# questo dice "il grafo puo' usarla per rispondere". Sono decisioni diverse e
# servono ENTRAMBE. Default OFF, e non per prudenza generica: ogni misura di
# questo repo (golden gate, baseline per-lingua, conteggio WRONG_ALTA) e' stata
# presa con il web spento, dove un corpus che non sa produce un rifiuto.
# Accendendola quegli item possono uscire a livello WEB — un livello suo, mai
# ALTA e mai MEDIA — e due run smetterebbero di essere confrontabili senza che
# nessuno se ne accorga. Chi accende, accende apposta: l'audit lo dichiara.
AIKE_WEB_CASCADE=0
# Segreto dell'istanza SearXNG. NON committare il valore reale.
# Generare con: openssl rand -hex 32
# Avvio: SEARXNG_SECRET=... docker compose --profile web up -d searxng
SEARXNG_SECRET=
SEARXNG_BASE_URL=http://localhost:8888/
